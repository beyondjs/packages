{
	"name": "my-package",
	"version": "0.0.1",
	"description": "A test package",
	"main": "./dist/main.cjs",
	"module": "./dist/main.mjs",
	"browser": "./dist/browser.js",
	"type": "module",
	"bundlers": {
		"exports": "@beyond-js/packages/bundlers/exports"
	},
	"exports": {
		".": {
			"import": "./dist/main.mjs",
			"require": "./dist/main.cjs",
			"types": "./dist/types.d.ts",
			"default": "./dist/main.js"
		},
		"./utils": {
			"node": {
				"import": "./dist/node/utils.mjs",
				"require": "./dist/node/utils.cjs"
			},
			"browser": {
				"default": "./dist/browser/utils.js"
			}
		},
		"./subpath": "./dist/subpath.js",
		"./custom-condition": {
			"development": "./dist/dev.js",
			"production": "./dist/prod.js",
			"default": "./dist/index.js"
		},
		"./style.css": "./dist/style.css"
	},
	"keywords": [
		"parser",
		"exports",
		"package.json"
	],
	"author": "Tu Nombre",
	"license": "MIT"
}
