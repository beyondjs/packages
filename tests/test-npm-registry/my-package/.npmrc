# Default registry for packages without a specific scope
registry=https://registry.npmjs.org/

# Token-based authentication for the official NPM registry
//registry.npmjs.org/:_authToken=abc123xyz456

# Custom registry for the @acme scope (e.g., Verdaccio)
@acme:registry=https://verdaccio.acme.com/

# Token-based authentication for Verdaccio registry
//verdaccio.acme.com/:_authToken=token-for-acme

# Basic authentication using base64(user:password)
_auth=dXNlcjpwYXNzd29yZA==

# Explicit user/password authentication (used by some enterprise registries)
# Note: Not all registries support this format
//my.custom.registry.com/:username=myuser
//my.custom.registry.com/:password=mypassword