{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "urn:beyond:dev-files:1",
	"title": "Dev Server source, event and build documents, protocol beyond-dev-files/1",
	"$defs": {
		"path": {
			"type": "string",
			"description": "Relative to the served root, POSIX separators, no empty, `.` or `..` segment. A path names a file, never a public module.",
			"pattern": "^(?!.*(^|/)\\.{1,2}(/|$))[^/\\\\\\u0000][^\\\\\\u0000]*$",
			"not": {
				"pattern": "//|/$"
			}
		},
		"revision": {
			"type": "string",
			"description": "Digest of the file bytes. The HTTP entity tag of a file is this value in quotes.",
			"pattern": "^sha256-[a-f0-9]{64}$"
		},
		"expected": {
			"description": "What the writer believes is on disk: a revision, or `absent` when the path must not exist",
			"anyOf": [
				{
					"$ref": "#/$defs/revision"
				},
				{
					"const": "absent"
				}
			]
		},
		"cursor": {
			"type": "string",
			"description": "`<epoch>:<seq>`. The epoch changes whenever the server cannot vouch for continuity: restart, watcher failure, log overflow.",
			"pattern": "^[A-Za-z0-9]{6,32}:[0-9]+$"
		},
		"origin": {
			"enum": [
				"api",
				"external",
				"scan"
			],
			"description": "`api`: a mutation of this API. `external`: a watcher observed a write that bypassed it (agent shell, Git, another tool). `scan`: found by comparing disk with the index, so its time and author are unknown."
		},
		"actor": {
			"type": "object",
			"description": "Copied from the verified grant of an `api` mutation; absent for every other origin",
			"required": [
				"sub",
				"kind"
			],
			"additionalProperties": false,
			"properties": {
				"sub": {
					"type": "string"
				},
				"kind": {
					"enum": [
						"user",
						"agent",
						"service"
					]
				},
				"task": {
					"type": "string"
				}
			}
		},
		"entry": {
			"type": "object",
			"required": [
				"path",
				"kind"
			],
			"additionalProperties": false,
			"properties": {
				"path": {
					"$ref": "#/$defs/path"
				},
				"kind": {
					"enum": [
						"file",
						"directory"
					]
				},
				"size": {
					"type": "integer",
					"minimum": 0
				},
				"revision": {
					"$ref": "#/$defs/revision"
				}
			},
			"if": {
				"properties": {
					"kind": {
						"const": "file"
					}
				}
			},
			"then": {
				"required": [
					"size",
					"revision"
				]
			}
		},
		"tree": {
			"type": "object",
			"description": "A snapshot boundary: `entries` describe the root exactly as of `cursor`; events after that cursor apply on top of it",
			"required": [
				"protocol",
				"cursor",
				"scanned",
				"entries"
			],
			"additionalProperties": false,
			"properties": {
				"protocol": {
					"const": "beyond-dev-files/1"
				},
				"cursor": {
					"$ref": "#/$defs/cursor"
				},
				"scanned": {
					"type": "boolean",
					"description": "Whether disk was re-read for this answer instead of trusting the watcher-fed index"
				},
				"entries": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/entry"
					}
				}
			}
		},
		"mutation": {
			"type": "object",
			"required": [
				"operation",
				"path",
				"expected"
			],
			"additionalProperties": false,
			"properties": {
				"operation": {
					"enum": [
						"write",
						"delete",
						"rename"
					]
				},
				"path": {
					"$ref": "#/$defs/path"
				},
				"expected": {
					"$ref": "#/$defs/expected"
				},
				"to": {
					"$ref": "#/$defs/path"
				},
				"content": {
					"type": "string"
				},
				"encoding": {
					"enum": [
						"utf8",
						"base64"
					]
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"operation": {
								"const": "write"
							}
						}
					},
					"then": {
						"required": [
							"content"
						]
					}
				},
				{
					"if": {
						"properties": {
							"operation": {
								"const": "rename"
							}
						}
					},
					"then": {
						"required": [
							"to"
						]
					}
				},
				{
					"if": {
						"properties": {
							"operation": {
								"enum": [
									"delete",
									"rename"
								]
							}
						}
					},
					"then": {
						"properties": {
							"expected": {
								"$ref": "#/$defs/revision"
							}
						}
					}
				}
			]
		},
		"result": {
			"type": "object",
			"required": [
				"outcome",
				"path"
			],
			"additionalProperties": false,
			"properties": {
				"outcome": {
					"enum": [
						"completed",
						"conflict",
						"failed",
						"skipped"
					]
				},
				"path": {
					"$ref": "#/$defs/path"
				},
				"revision": {
					"$ref": "#/$defs/revision"
				},
				"cursor": {
					"$ref": "#/$defs/cursor"
				},
				"conflict": {
					"type": "object",
					"required": [
						"expected",
						"current"
					],
					"additionalProperties": false,
					"properties": {
						"expected": {
							"$ref": "#/$defs/expected"
						},
						"current": {
							"$ref": "#/$defs/expected"
						},
						"target": {
							"$ref": "#/$defs/path",
							"description": "Set when the conflict is the existing destination of a rename"
						}
					}
				},
				"error": {
					"type": "object",
					"required": [
						"code",
						"message"
					],
					"properties": {
						"code": {
							"type": "string"
						},
						"message": {
							"type": "string"
						}
					}
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"outcome": {
								"const": "conflict"
							}
						}
					},
					"then": {
						"required": [
							"conflict"
						]
					}
				},
				{
					"if": {
						"properties": {
							"outcome": {
								"const": "failed"
							}
						}
					},
					"then": {
						"required": [
							"error"
						]
					}
				}
			]
		},
		"batch": {
			"type": "object",
			"description": "Ordered and not atomic. `partial` says earlier mutations are on disk and later ones are not.",
			"required": [
				"id",
				"outcome",
				"results"
			],
			"additionalProperties": false,
			"properties": {
				"id": {
					"type": "string",
					"minLength": 1
				},
				"outcome": {
					"enum": [
						"completed",
						"partial",
						"rejected"
					]
				},
				"results": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/result"
					}
				}
			}
		},
		"diagnostic": {
			"type": "object",
			"required": [
				"code",
				"message"
			],
			"additionalProperties": false,
			"properties": {
				"code": {
					"type": "string"
				},
				"message": {
					"type": "string"
				},
				"severity": {
					"enum": [
						"error",
						"warning"
					]
				},
				"file": {
					"$ref": "#/$defs/path"
				},
				"revision": {
					"$ref": "#/$defs/revision",
					"description": "The revision of `file` that was compiled"
				},
				"range": {
					"type": "object",
					"required": [
						"line",
						"column"
					],
					"properties": {
						"line": {
							"type": "integer",
							"minimum": 1
						},
						"column": {
							"type": "integer",
							"minimum": 1
						}
					}
				}
			}
		},
		"build": {
			"type": "object",
			"description": "`input` is the cursor the build read its sources at. A build whose input is older than a later change to one of its files ends `superseded` and is never reported as current.",
			"required": [
				"id",
				"state",
				"input",
				"modules"
			],
			"additionalProperties": false,
			"properties": {
				"id": {
					"type": "string",
					"minLength": 1
				},
				"state": {
					"enum": [
						"running",
						"completed",
						"failed",
						"superseded",
						"cancelled"
					]
				},
				"input": {
					"$ref": "#/$defs/cursor"
				},
				"modules": {
					"type": "array",
					"items": {
						"type": "object",
						"required": [
							"vspecifier",
							"status"
						],
						"additionalProperties": false,
						"properties": {
							"vspecifier": {
								"type": "string"
							},
							"platform": {
								"enum": [
									"node",
									"web"
								],
								"description": "The platform the artifact was built for. A module is listed once for each platform it declares, and a consumer applies the artifact of its own platform. Absent when the module declares none of the platforms the service builds for, which is reported as invalid."
							},
							"status": {
								"enum": [
									"valid",
									"invalid"
								]
							},
							"hash": {
								"type": "string"
							},
							"styles": {
								"type": "string",
								"description": "The hash of the stylesheet of the module, when its sources produce one. It changes with the stylesheet alone, so a consumer that holds the sheet replaces it when the code of the module did not change, and the update route delivers the sheet by this hash."
							},
							"declaration": {
								"type": "string",
								"description": "The hash of the public declaration of the module, the same for every platform, when its sources check. It changes with the declaration alone."
							}
						}
					}
				},
				"diagnostics": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/diagnostic"
					}
				}
			}
		},
		"selection": {
			"type": "object",
			"description": "Which packages and public modules of the workspace are in development: a preview loads them from this environment and every other dependency from the CDN. Only a replacement changes it, and a replacement states the whole selection. `explicit: false` means nobody selected yet, and then `packages` lists every package of the workspace. `externals` says where a preview loads the installed packages this environment could compile itself: here (`environment`, the default) or from the CDN at their installed exact version (`cdn`).",
			"required": [
				"explicit",
				"packages",
				"modules",
				"externals",
				"unknown"
			],
			"additionalProperties": false,
			"properties": {
				"explicit": {
					"type": "boolean"
				},
				"packages": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"uniqueItems": true
				},
				"modules": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"uniqueItems": true
				},
				"externals": {
					"enum": [
						"environment",
						"cdn"
					]
				},
				"unknown": {
					"type": "array",
					"description": "Selected names that the workspace no longer declares. They select nothing and are kept.",
					"items": {
						"type": "string",
						"minLength": 1
					}
				}
			}
		},
		"preview": {
			"type": "object",
			"description": "What the entry document of a preview loads and where from. Addresses of this environment are relative to the document, so they hold behind a proxy that publishes the service under a path prefix; addresses of the CDN are absolute. No address carries a credential.",
			"required": [
				"protocol",
				"entry",
				"options",
				"cdn",
				"selection",
				"modules",
				"importmap",
				"updates",
				"diagnostics"
			],
			"additionalProperties": false,
			"properties": {
				"protocol": {
					"const": "beyond-dev-files/1"
				},
				"entry": {
					"type": "object",
					"required": [
						"specifier",
						"vspecifier"
					],
					"additionalProperties": false,
					"properties": {
						"specifier": {
							"type": "string",
							"minLength": 1
						},
						"vspecifier": {
							"type": "string",
							"minLength": 1
						}
					}
				},
				"options": {
					"type": "string",
					"description": "The query of the modules in development, which their updates are requested with"
				},
				"cdn": {
					"type": "object",
					"description": "The configured CDN origin, or the reason there is none. An origin is never invented.",
					"additionalProperties": false,
					"properties": {
						"origin": {
							"type": "string",
							"pattern": "^https?://"
						},
						"reason": {
							"type": "string",
							"minLength": 1
						}
					},
					"oneOf": [
						{
							"required": [
								"origin"
							]
						},
						{
							"required": [
								"reason"
							]
						}
					]
				},
				"selection": {
					"type": "object",
					"description": "The selection the description was routed by: whether somebody selected, and its externals. `reason` says why the externals do not decide anything, for a workspace served from its installed graph.",
					"required": [
						"explicit",
						"externals"
					],
					"additionalProperties": false,
					"properties": {
						"explicit": {
							"type": "boolean"
						},
						"externals": {
							"enum": [
								"environment",
								"cdn"
							]
						},
						"reason": {
							"type": "string",
							"minLength": 1
						}
					}
				},
				"modules": {
					"type": "array",
					"items": {
						"type": "object",
						"required": [
							"specifier",
							"source"
						],
						"additionalProperties": false,
						"properties": {
							"specifier": {
								"type": "string",
								"minLength": 1
							},
							"source": {
								"enum": [
									"environment",
									"cdn",
									"unresolved"
								]
							},
							"version": {
								"type": "string"
							},
							"url": {
								"type": "string"
							},
							"reason": {
								"type": "string"
							},
							"vspecifier": {
								"type": "string",
								"description": "The versioned identity of a module served by this environment, which builds and the runtime name it by."
							},
							"styles": {
								"type": "string",
								"description": "The address of the stylesheet of a module served by this environment, relative to the document, when its sources produce one. The document links the stylesheets of the modules that are not widgets; a widget adopts its own inside its shadow root."
							},
							"stylesheets": {
								"type": "array",
								"description": "The stylesheets the sources of the module select by specifier (`pkg/sub.css`): the stylesheet of that public module, with its address and the versioned identity the runtime replaces it by. The document links those of the modules in its scope; a widget adopts them.",
								"items": {
									"type": "object",
									"required": [
										"specifier",
										"vspecifier",
										"url"
									],
									"additionalProperties": false,
									"properties": {
										"specifier": {
											"type": "string",
											"pattern": "\\.css$"
										},
										"vspecifier": {
											"type": "string",
											"minLength": 1
										},
										"url": {
											"type": "string",
											"minLength": 1
										}
									}
								}
							},
							"widget": {
								"type": "boolean",
								"description": "Whether the module declares a widget."
							},
							"scope": {
								"type": "string",
								"enum": [
									"document",
									"widget"
								],
								"description": "Who holds the stylesheet of a module that has one: the document, when the entry reaches the module without crossing a widget, or the widgets that import it, which adopt it in their own roots. The document links only the stylesheets in its scope."
							}
						},
						"allOf": [
							{
								"if": {
									"properties": {
										"source": {
											"const": "environment"
										}
									}
								},
								"then": {
									"required": [
										"url",
										"version"
									],
									"properties": {
										"url": {
											"type": "string",
											"pattern": "^\\.\\./m/"
										}
									}
								}
							},
							{
								"if": {
									"properties": {
										"source": {
											"const": "cdn"
										}
									}
								},
								"then": {
									"required": [
										"url",
										"version"
									],
									"properties": {
										"url": {
											"type": "string",
											"pattern": "^https?://"
										}
									}
								}
							},
							{
								"if": {
									"properties": {
										"source": {
											"const": "unresolved"
										}
									}
								},
								"then": {
									"required": [
										"reason"
									],
									"not": {
										"required": [
											"url"
										]
									}
								}
							}
						]
					}
				},
				"importmap": {
					"type": "object",
					"required": [
						"imports"
					],
					"additionalProperties": false,
					"properties": {
						"imports": {
							"type": "object",
							"additionalProperties": {
								"type": "string",
								"pattern": "^(\\.\\./m/|https?://)"
							}
						},
						"scopes": {
							"type": "object",
							"description": "The imports of the importers that resolve another version of a specifier, by the package prefix of the importer's address, as a release scopes them. Present only when an importer needs one.",
							"propertyNames": {
								"pattern": "^(\\.\\./m/|https?://)"
							},
							"additionalProperties": {
								"type": "object",
								"additionalProperties": {
									"type": "string",
									"description": "An address, or a module that throws why an importer's import has no address (`data:text/javascript,`), so the importer never falls back to the version the page imports: an import of an installed graph without one, or a version the CDN does not hold under the `cdn` externals.",
									"pattern": "^(\\.\\./m/|https?://|data:text/javascript,)"
								}
							}
						},
						"integrity": {
							"type": "object",
							"description": "Under the `cdn` externals, the integrity of every address on the CDN the document gives, as subresource integrity metadata of the digest the CDN answered for it (its strong `sha256-<hex>` entity tag, in base64): a browser loads those bytes or none. Present only when the description gives an address on the CDN.",
							"propertyNames": {
								"pattern": "^https?://"
							},
							"additionalProperties": {
								"type": "string",
								"pattern": "^sha256-[A-Za-z0-9+/]{43}=$"
							}
						}
					}
				},
				"updates": {
					"type": "object",
					"description": "`runtime` is the development coordinator the document registers this service in, which is what applies updates to the running page, from the workspace or from the CDN. `session` is what the document gives it of the session of the service: the options of the updates and the modules in development, by specifier, which is all it needs and nothing a visitor's grant does not already see in the import map, so it never reads `/session`. Without a coordinator, `reason` says why nothing applies updates: new code then appears only when the document is loaded again, which is not an update.",
					"additionalProperties": false,
					"properties": {
						"runtime": {
							"type": "string",
							"minLength": 1
						},
						"session": {
							"type": "object",
							"required": [
								"options",
								"modules"
							],
							"additionalProperties": false,
							"properties": {
								"options": {
									"type": "string"
								},
								"modules": {
									"type": "object",
									"additionalProperties": {
										"type": "object",
										"required": [
											"package",
											"vspecifier",
											"path"
										],
										"additionalProperties": false,
										"properties": {
											"package": {
												"type": "string",
												"minLength": 1
											},
											"vspecifier": {
												"type": "string",
												"minLength": 1
											},
											"path": {
												"type": "string",
												"pattern": "^/m/"
											}
										}
									}
								}
							}
						},
						"reason": {
							"type": "string",
							"minLength": 1
						}
					},
					"oneOf": [
						{
							"required": [
								"runtime",
								"session"
							]
						},
						{
							"required": [
								"reason"
							]
						}
					]
				},
				"diagnostics": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/diagnostic"
					}
				}
			}
		},
		"output": {
			"type": "object",
			"description": "One output of a public module for one platform. `source` is where it comes from: a module of the workspace in development, served by this environment (`workspace`); something else this environment serves, or that its Node consumer resolves itself from the installation (`environment`: a package the toolchain supplies, an installed package); the CDN (`cdn`); or no address, with the reason (`unresolved`). `built` and `failed` are this environment's builds, `hash` the hash of the output it built (a style module has a stylesheet and no code, so no hash); `prepared` is an output the CDN answered with itself when its address was checked (`digest`, the entity tag it answered, which the import map pins as its integrity), and `missing`, `unverified` and `unavailable` an address that could not be bound to an answer, which leaves the output `unresolved`; `unknown` was not measured.",
			"required": [
				"source",
				"state"
			],
			"additionalProperties": false,
			"properties": {
				"source": {
					"enum": [
						"workspace",
						"environment",
						"cdn",
						"unresolved"
					]
				},
				"state": {
					"enum": [
						"built",
						"failed",
						"prepared",
						"missing",
						"unverified",
						"unavailable",
						"unknown"
					]
				},
				"address": {
					"type": "string",
					"pattern": "^(\\.\\./m/|https?://)"
				},
				"hash": {
					"type": "string",
					"minLength": 1
				},
				"digest": {
					"type": "string",
					"pattern": "^sha256-[0-9a-f]{64}$"
				},
				"reason": {
					"type": "string",
					"minLength": 1
				},
				"builtins": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"uniqueItems": true
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"source": {
								"const": "unresolved"
							}
						}
					},
					"then": {
						"required": [
							"reason"
						],
						"not": {
							"required": [
								"address"
							]
						}
					}
				},
				{
					"if": {
						"properties": {
							"source": {
								"const": "cdn"
							}
						}
					},
					"then": {
						"required": [
							"address"
						],
						"properties": {
							"address": {
								"type": "string",
								"pattern": "^https?://"
							},
							"state": {
								"enum": [
									"prepared",
									"unknown"
								]
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"state": {
								"const": "prepared"
							}
						}
					},
					"then": {
						"properties": {
							"source": {
								"const": "cdn"
							}
						}
					}
				}
			]
		},
		"composition": {
			"type": "object",
			"description": "The composition of the application of the served workspace (`GET /preview/composition.json?entry=`, protocol `beyond-dev-composition/1`): its packages, its public modules with their outputs per platform, and the public dependencies between modules, in three lists kept apart. The page of `entry` decides the web outputs, as the preview description does; every public module of the workspace that declares Node is described with its Node output and what it imports. The files of a module are not part of it. It describes and decides nothing.",
			"required": [
				"protocol",
				"entry",
				"selection",
				"cdn",
				"packages",
				"modules",
				"edges",
				"diagnostics"
			],
			"additionalProperties": false,
			"properties": {
				"protocol": {
					"const": "beyond-dev-composition/1"
				},
				"entry": {
					"$ref": "#/$defs/preview/properties/entry"
				},
				"selection": {
					"$ref": "#/$defs/preview/properties/selection"
				},
				"cdn": {
					"$ref": "#/$defs/preview/properties/cdn"
				},
				"packages": {
					"type": "array",
					"items": {
						"type": "object",
						"description": "A package: `<name>@<version>`, prefixed by its registry id and a colon when it comes from a registry other than npm. `source` is the source of its modules' outputs when they agree and `mixed` when they do not. `provider` is who provides its sources: a member of the workspace, the toolchain (a supplied package), an installation on this machine, the store of an installed graph, or only a registry. `dependencies` is what its manifest declares, when this environment can read it, with the versions of each name its modules reach in this composition.",
						"required": [
							"id",
							"name",
							"source",
							"provider"
						],
						"additionalProperties": false,
						"properties": {
							"id": {
								"type": "string",
								"minLength": 1
							},
							"name": {
								"type": "string",
								"minLength": 1
							},
							"version": {
								"type": "string",
								"minLength": 1
							},
							"source": {
								"enum": [
									"workspace",
									"environment",
									"cdn",
									"unresolved",
									"mixed"
								]
							},
							"reason": {
								"type": "string",
								"minLength": 1
							},
							"provider": {
								"enum": [
									"workspace",
									"toolchain",
									"installation",
									"store",
									"registry"
								]
							},
							"registry": {
								"type": "string",
								"minLength": 1
							},
							"dependencies": {
								"type": "array",
								"items": {
									"type": "object",
									"required": [
										"name",
										"range",
										"kind",
										"resolved"
									],
									"additionalProperties": false,
									"properties": {
										"name": {
											"type": "string",
											"minLength": 1
										},
										"range": {
											"type": "string"
										},
										"kind": {
											"enum": [
												"dependencies",
												"peerDependencies",
												"optionalDependencies",
												"devDependencies"
											]
										},
										"resolved": {
											"type": "array",
											"items": {
												"type": "string",
												"minLength": 1
											},
											"uniqueItems": true
										}
									}
								}
							}
						}
					}
				},
				"modules": {
					"type": "array",
					"items": {
						"type": "object",
						"description": "A public module, identified as `<package id>/<subpath>` (the package id for the root subpath), with its output for each platform it is described for. `loaded` says whether the preview page of the entry loads it.",
						"required": [
							"id",
							"specifier",
							"package",
							"subpath",
							"loaded",
							"platforms",
							"outputs"
						],
						"additionalProperties": false,
						"properties": {
							"id": {
								"type": "string",
								"minLength": 1
							},
							"specifier": {
								"type": "string",
								"minLength": 1
							},
							"package": {
								"type": "string",
								"minLength": 1
							},
							"subpath": {
								"type": "string",
								"pattern": "^(\\.|\\./.+)$"
							},
							"vspecifier": {
								"type": "string",
								"minLength": 1
							},
							"widget": {
								"const": true
							},
							"loaded": {
								"type": "boolean"
							},
							"platforms": {
								"type": "array",
								"items": {
									"enum": [
										"web",
										"node"
									]
								},
								"uniqueItems": true,
								"minItems": 1
							},
							"outputs": {
								"type": "object",
								"additionalProperties": false,
								"minProperties": 1,
								"properties": {
									"web": {
										"$ref": "#/$defs/output"
									},
									"node": {
										"$ref": "#/$defs/output"
									}
								}
							}
						}
					}
				},
				"edges": {
					"type": "array",
					"items": {
						"type": "object",
						"description": "A public dependency of one module on another, by their identities, for one platform. `runtime` marks the runtime the artifact is assembled against, which its sources do not import.",
						"required": [
							"from",
							"to",
							"specifier",
							"platform"
						],
						"additionalProperties": false,
						"properties": {
							"from": {
								"type": "string",
								"minLength": 1
							},
							"to": {
								"type": "string",
								"minLength": 1
							},
							"specifier": {
								"type": "string",
								"minLength": 1
							},
							"platform": {
								"enum": [
									"web",
									"node"
								]
							},
							"runtime": {
								"const": true
							}
						}
					}
				},
				"diagnostics": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/diagnostic"
					}
				}
			}
		},
		"event": {
			"type": "object",
			"required": [
				"cursor",
				"type"
			],
			"additionalProperties": false,
			"properties": {
				"cursor": {
					"$ref": "#/$defs/cursor"
				},
				"type": {
					"enum": [
						"file.created",
						"file.changed",
						"file.deleted",
						"file.renamed",
						"batch.completed",
						"build.started",
						"build.ended",
						"selection.changed",
						"resync",
						"access.ended",
						"stopping",
						"export.changed"
					]
				},
				"path": {
					"$ref": "#/$defs/path"
				},
				"from": {
					"$ref": "#/$defs/path"
				},
				"revision": {
					"$ref": "#/$defs/revision"
				},
				"previous": {
					"$ref": "#/$defs/revision"
				},
				"origin": {
					"$ref": "#/$defs/origin"
				},
				"actor": {
					"$ref": "#/$defs/actor"
				},
				"batch": {
					"type": "string"
				},
				"build": {
					"$ref": "#/$defs/build"
				},
				"selection": {
					"$ref": "#/$defs/selection"
				},
				"export": {
					"description": "A source export of a service that pairs browsers (`beyond-dev-exports/1`), as `export.changed` announces it: its identifier, state and expiry, the capture it was transferred to and the transfer's state per package. Announced only to subscribers that read files.",
					"type": "object",
					"required": ["id", "state"],
					"properties": {
						"id": { "type": "string", "pattern": "^exp_[0-9a-f]{32}$" },
						"state": { "type": "string" },
						"expires": { "type": "string" },
						"capture": { "type": "object" },
						"transfer": { "type": "object" }
					}
				},
				"reason": {
					"enum": [
						"EPOCH",
						"GAP",
						"OVERFLOW",
						"WATCHER",
						"GRANT_EXPIRED",
						"GRANT_REVOKED",
						"PAIRING_EXPIRED",
						"PAIRING_REVOKED",
						"SHUTDOWN"
					]
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"type": {
								"enum": [
									"file.created",
									"file.changed",
									"file.deleted",
									"file.renamed"
								]
							}
						}
					},
					"then": {
						"required": [
							"path",
							"origin"
						]
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "file.renamed"
							}
						}
					},
					"then": {
						"required": [
							"from"
						],
						"properties": {
							"origin": {
								"const": "api"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"enum": [
									"build.started",
									"build.ended"
								]
							}
						}
					},
					"then": {
						"required": [
							"build"
						]
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "selection.changed"
							}
						}
					},
					"then": {
						"required": [
							"selection"
						]
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "export.changed"
							}
						}
					},
					"then": {
						"required": [
							"export"
						]
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"enum": [
									"resync",
									"access.ended"
								]
							}
						}
					},
					"then": {
						"required": [
							"reason"
						]
					}
				}
			]
		}
	}
}
